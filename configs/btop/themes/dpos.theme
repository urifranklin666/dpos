#dpos — operator-cult industrial btop theme.
#Red-only gradients across the board. No green→amber→red rainbow.
#Tokens mirror /homepage CSS variables.

theme[main_bg]="#060606"
theme[main_fg]="#dedede"
theme[title]="#ff2222"
theme[hi_fg]="#cc0000"
theme[selected_bg]="#3a0000"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#606060"
theme[graph_text]="#9a9a9a"
theme[meter_bg]="#1c0000"
theme[proc_misc]="#cc0000"

theme[cpu_box]="#cc0000"
theme[mem_box]="#cc0000"
theme[net_box]="#cc0000"
theme[proc_box]="#cc0000"
theme[div_line]="#2b0000"

# All gradients keep the brand red — dim → bright as the value climbs.
theme[temp_start]="#880000"
theme[temp_mid]="#cc0000"
theme[temp_end]="#ff2222"

theme[cpu_start]="#880000"
theme[cpu_mid]="#cc0000"
theme[cpu_end]="#ff2222"

theme[free_start]="#880000"
