# dpos / zsh — small, native, no framework.
# prompt: two lines, red brackets, dim path, bright cursor mark.

# ---- history --------------------------------------------------------------
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=20000
SAVEHIST=20000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS \
       APPEND_HISTORY INC_APPEND_HISTORY

# ---- options --------------------------------------------------------------
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt EXTENDED_GLOB NOMATCH NUMERIC_GLOB_SORT
setopt INTERACTIVE_COMMENTS
setopt PROMPT_SUBST
unsetopt BEEP

# ---- completion -----------------------------------------------------------
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

zstyle ':completion:*'                 menu select
zstyle ':completion:*'                 group-name ''
zstyle ':completion:*'                 list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions'    format $'%F{160}// %d%f'
zstyle ':completion:*:warnings'        format $'%F{160}// no matches%f'
zstyle ':completion:*'                 verbose true

# ---- keybindings ----------------------------------------------------------
bindkey -e
bindkey '^[[A'   history-search-backward
bindkey '^[[B'   history-search-forward
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

# ---- colors / palette ----------------------------------------------------
autoload -U colors && colors
export CLICOLOR=1
export LSCOLORS='ExFxBxDxCxegedabagacad'
# Red brand color for ANSI consumers:
export LS_COLORS="di=38;5;160:ln=38;5;88:so=38;5;196:pi=38;5;88:ex=38;5;160:bd=38;5;88:cd=38;5;88:su=38;5;196:sg=38;5;160:tw=38;5;88:ow=38;5;88"

# ---- prompt ---------------------------------------------------------------
# git branch in prompt without a plugin
function _dpos_git_branch() {
  local ref
  ref=$(command git symbolic-ref --short HEAD 2>/dev/null) || \
  ref=$(command git rev-parse --short HEAD 2>/dev/null) || return 0
  printf '%s' " %F{88}[git:${ref}]%f"
}

# return code marker
function _dpos_retcode() {
  local rc=$?
  if (( rc != 0 )); then
    printf ' %%F{196}!%d%%f' "$rc"
  fi
}

PROMPT=$'\n%F{160}[%n@%m]%f %F{240}[%~]%f$(_dpos_git_branch)$(_dpos_retcode)\n%F{196}▌%f '
RPROMPT=$''

# ---- aliases --------------------------------------------------------------
[[ -f "${HOME}/.zsh_aliases" ]] && source "${HOME}/.zsh_aliases"

# ---- editor / pager -------------------------------------------------------
export EDITOR="${EDITOR:-vim}"
export VISUAL="${VISUAL:-${EDITOR}}"
export PAGER="${PAGER:-less}"
export LESS='-R -F -X -i -M'
export MANPAGER='less -R --use-color -Dd+r -Du+b'

# Make less render in brand red where it can
export LESS_TERMCAP_md=$'\e[38;5;160m'    # bold
export LESS_TERMCAP_mb=$'\e[38;5;196m'    # blink
export LESS_TERMCAP_us=$'\e[4m\e[38;5;196m' # underline
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_so=$'\e[48;5;52;38;5;255m' # standout
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_me=$'\e[0m'

# ---- path -----------------------------------------------------------------
typeset -U path
path=(
  "$HOME/.local/bin"
  "$HOME/bin"
  $path
)
export PATH

# ---- pi-friendly defaults -------------------------------------------------
# disable that ridiculous PIP "you're behind on pip" check
export PIP_DISABLE_PIP_VERSION_CHECK=1
# stop systemd from paging on units-output when piping to less
export SYSTEMD_PAGER=""

# ---- ansi-art on shell open (optional) ------------------------------------
# uncomment to see the deadplug logo every shell open:
# [[ -t 1 && -z "${DPOS_NO_BANNER:-}" && -r "$HOME/.local/share/dpos/logo.ans" ]] && cat "$HOME/.local/share/dpos/logo.ans"

# ---- welcome -- only on a tty and only the first time per terminal --------
if [[ -t 1 && -z "${_DPOS_WELCOMED:-}" && -z "${INSIDE_EMACS:-}" && -z "${TMUX:-}" ]]; then
  export _DPOS_WELCOMED=1
  if command -v fortune >/dev/null 2>&1; then
    print -P "%F{160}// %f%F{240}$(fortune -s deadplug 2>/dev/null || fortune -s 2>/dev/null | head -3)%f"
  fi
fi
