" dpos / vim — minimal, on-brand defaults.
" Loads the dpos colorscheme, sets sensible editing defaults, no plugins.

set nocompatible
filetype plugin indent on
syntax on

if has('termguicolors')
  set termguicolors
endif

set background=dark
silent! colorscheme dpos

" ---- editing defaults ----
set number relativenumber
set cursorline
set scrolloff=4
set sidescrolloff=8
set wrap linebreak
set showmatch
set hidden
set lazyredraw
set splitright splitbelow
set updatetime=300
set timeoutlen=500

set expandtab
set tabstop=2 shiftwidth=2 softtabstop=2
set autoindent smartindent

set ignorecase smartcase
set incsearch hlsearch

set noswapfile nobackup
set undofile
set undodir=~/.cache/vim/undo
silent! call mkdir(expand('~/.cache/vim/undo'), 'p')

set wildmenu
set wildmode=longest:full,full

set list listchars=tab:│\ ,trail:·,extends:›,precedes:‹,nbsp:␣
set fillchars=vert:│,fold:─,eob:\

set laststatus=2
set noshowmode    " mode is in our statusline below

" ---- statusline — operator-cult industrial ----
function! DposGitBranch() abort
  let l:branch = system('git -C ' . shellescape(expand('%:p:h')) . ' symbolic-ref --short HEAD 2>/dev/null')
  return substitute(l:branch, '\n', '', 'g')
endfunction

set statusline=
set statusline+=%#StatusLine#\ %#Function#//\ %#StatusLine#%t       " filename
set statusline+=\ %#Comment#%m%r%h%w                                 " mod/ro/help flags
set statusline+=%=                                                   " right-align
set statusline+=%#Comment#%{DposGitBranch()!=''?'git:'.DposGitBranch().'\ ·\ ':''}
set statusline+=%#StatusLine#%y\ ·\ %#Comment#%p%%\ ·\ %l:%c\

" ---- keymaps ----
let mapleader = " "
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>h :nohlsearch<CR>
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
